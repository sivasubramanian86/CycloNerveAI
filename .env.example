# CycloNerveAI - Environment Configuration
# Kept strictly server-side. Never expose credentials to client bundles.

# -------------------------------------------------------------
# 1. Global Adapter Mode Configuration
# -------------------------------------------------------------
# ADAPTER_MODE: "mock" (default, local development) | "cloud" (production cloud services)
ADAPTER_MODE="mock"

# USE_MOCK_ADAPTERS: true (default for local development) | false
USE_MOCK_ADAPTERS="true"

# Granular per-adapter mode overrides ("mock" | "cloud")
EARTH_ENGINE_MODE="mock"
BIGQUERY_MODE="mock"
FIREBASE_AUTH_MODE="mock"
FIRESTORE_MODE="mock"
CLOUD_STORAGE_MODE="mock"
GOOGLE_MAPS_MODE="mock"
ADVISORY_DISPATCH_MODE="mock"

# -------------------------------------------------------------
# 2. Server Runtime Configuration
# -------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
APP_URL="http://localhost:3000"

# -------------------------------------------------------------
# 3. Gemini Orchestration Configuration (Phase 3)
# -------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"
GLOBAL_AI_KILL_SWITCH="false"

# -------------------------------------------------------------
# 4. Google Earth Engine Configuration (Phase 4 Live Mode)
# -------------------------------------------------------------
EARTH_ENGINE_PROJECT_ID=""
EARTH_ENGINE_SERVICE_ACCOUNT=""
EARTH_ENGINE_PRIVATE_KEY=""

# -------------------------------------------------------------
# 5. BigQuery Geospatial Configuration (Phase 4 Live Mode)
# -------------------------------------------------------------
BIGQUERY_PROJECT_ID=""
BIGQUERY_DATASET="cyclonerve_spatial_odisha"
GOOGLE_APPLICATION_CREDENTIALS=""

# -------------------------------------------------------------
# 6. Firebase Authentication & Firestore (Phase 4 Live Mode)
# -------------------------------------------------------------
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIRESTORE_DATABASE_ID="(default)"

# -------------------------------------------------------------
# 7. Google Cloud Storage (Phase 4 Live Mode)
# -------------------------------------------------------------
GCS_BUCKET_NAME="cyclonerve-disaster-assets"
GCS_PROJECT_ID=""

# -------------------------------------------------------------
# 8. Google Maps Platform (Phase 4 Live Mode - Server Side Only)
# -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=""

# -------------------------------------------------------------
# 9. Emergency Broadcast Carrier Gateways (Phase 4 Live Mode)
# -------------------------------------------------------------
CELL_BROADCAST_CENTER_URL=""
SMS_GATEWAY_API_KEY=""
MUNICIPAL_SIREN_IP_NETWORK=""
WHATSAPP_BUSINESS_API_TOKEN=""
